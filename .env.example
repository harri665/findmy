# Docker Compose reads .env automatically. npm/cargo development uses shell variables.
FM_ADMIN_PASSWORD=change-this-password
# Optional: base64-encoded 32-byte encryption key. Otherwise generated in /data.
FM_MASTER_KEY=
FINDMY_PORT=8080
# Docker builds show the coming soon page unless set to false and rebuilt.
VITE_COMING_SOON=true
RUST_LOG=info
