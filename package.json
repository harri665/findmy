{
  "name": "findmy",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "cargo run -p fm-server",
    "install:all": "npm install && npm install --prefix client",
    "build": "npm run build --prefix client && cargo build --release -p fm-server",
    "test": "cargo test --workspace --locked && npm test --prefix client",
    "lint": "npm run lint --prefix client"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
